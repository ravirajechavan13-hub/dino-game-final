<?xml version='1.0' encoding='utf-8'?>
<widget id="com.raviraj.dinogame" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Dino Run</name>
    <description>
        Endless desert dino runner with power coins, combos and missions.
    </description>
    <author email="you@example.com" href="https://example.com">
        Raviraj
    </author>

    <content src="index.html" />

    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <preference name="DisallowOverscroll" value="true" />
    <preference name="android-minSdkVersion" value="22" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#0f172a" />

    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="www/icon-512.png" />
    <preference name="AndroidWindowSplashScreenBackground" value="#0f172a" />
    <preference name="SplashMaintainAspectRatio" value="true" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="SplashScreenDelay" value="1200" />

    <engine name="android" spec=">=10.1.0" />

    <platform name="android">
        <icon density="ldpi"    src="www/icon-512.png" />
        <icon density="mdpi"    src="www/icon-512.png" />
        <icon density="hdpi"    src="www/icon-512.png" />
        <icon density="xhdpi"   src="www/icon-512.png" />
        <icon density="xxhdpi"  src="www/icon-512.png" />
        <icon density="xxxhdpi" src="www/icon-512.png" />

        <icon density="ldpi"    src="www/icon-512.png" background="#0f172a" />
        <icon density="mdpi"    src="www/icon-512.png" background="#0f172a" />
        <icon density="hdpi"    src="www/icon-512.png" background="#0f172a" />
        <icon density="xhdpi"   src="www/icon-512.png" background="#0f172a" />
        <icon density="xxhdpi"  src="www/icon-512.png" background="#0f172a" />
        <icon density="xxxhdpi" src="www/icon-512.png" background="#0f172a" />

        <splash density="port-ldpi"    src="www/icon-512.png" />
        <splash density="port-mdpi"    src="www/icon-512.png" />
        <splash density="port-hdpi"    src="www/icon-512.png" />
        <splash density="port-xhdpi"   src="www/icon-512.png" />
        <splash density="port-xxhdpi"  src="www/icon-512.png" />
        <splash density="port-xxxhdpi" src="www/icon-512.png" />

        <preference name="AndroidXEnabled" value="true" />
    </platform>

    <plugin name="cordova-plugin-splashscreen" spec="^6.0.2" />
</widget>
