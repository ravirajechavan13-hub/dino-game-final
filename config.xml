name: Build Dino Run APK

on:
  workflow_dispatch:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Setup Java (required by Gradle/Android)
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Install required Android SDK platform + build-tools
        run: |
          yes | sdkmanager --licenses || true
          sdkmanager "platforms;android-36" "build-tools;36.0.0"

      - name: Install Cordova CLI
        run: npm install -g cordova

      - name: Verify icon file exists
        run: test -f www/icon-512.png && echo "OK" || (echo "MISSING www/icon-512.png" && exit 1)

      - name: Add Android platform
        run: cordova platform add android

      - name: Cordova prepare
        run: cordova prepare android

      - name: Build debug APK
        run: cordova build android

      - name: Locate APK
        run: find platforms/android -name "*.apk"

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: DinoRun-debug-apk
          path: platforms/android/app/build/outputs/apk/debug/app-debug.apk
