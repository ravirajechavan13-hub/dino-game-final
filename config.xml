<?xml version='1.0' encoding='utf-8'?>
<widget id="com.raviraj.dinogame" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Dino Run</name>
    <description>
        Endless desert dino runner with power coins, combos and missions.
    </description>
    <author email="you@example.com" href="https://example.com">
        Raviraj
    </author>

    <content src="index.html" />

    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <preference name="DisallowOverscroll" value="true" />
    <preference name="android-minSdkVersion" value="22" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#0f172a" />

    <!--
      Android 12+ native splash icon. This is the ONLY supported way
      to set a splash icon on cordova-android 15 — the old <splash>
      tags were removed in this version, which is why they were
      deleted below.
    -->
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="www/icon-512.png" />
    <preference name="AndroidWindowSplashScreenBackground" value="#0f172a" />
    <preference name="SplashMaintainAspectRatio" value="true" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="SplashScreenDelay" value="1200" />

    <engine name="android" spec=">=10.1.0" />

    <platform name="android">
        <!--
          Legacy square launcher icon (used on older Android / as a
          fallback). Uses the plain "src" attribute.
        -->
        <icon density="ldpi"    src="www/icon-512.png" />
        <icon density="mdpi"    src="www/icon-512.png" />
        <icon density="hdpi"    src="www/icon-512.png" />
        <icon density="xhdpi"   src="www/icon-512.png" />
        <icon density="xxhdpi"  src="www/icon-512.png" />
        <icon density="xxxhdpi" src="www/icon-512.png" />

        <!--
          Adaptive icon (Android 8+) — THIS is what replaces the grey
          Cordova robot. IMPORTANT: cordova-android requires the
          attribute to be named "foreground" here, NOT "src". Using
          "src" + "background" together (like we did before) throws:
          "One of the following attributes are set but missing the
          other for the density type ..." — that was the exact error
          in the failed build.
        -->
        <icon density="ldpi"    foreground="www/icon-512.png" background="#0f172a" />
        <icon density="mdpi"    foreground="www/icon-512.png" background="#0f172a" />
        <icon density="hdpi"    foreground="www/icon-512.png" background="#0f172a" />
        <icon density="xhdpi"   foreground="www/icon-512.png" background="#0f172a" />
        <icon density="xxhdpi"  foreground="www/icon-512.png" background="#0f172a" />
        <icon density="xxxhdpi" foreground="www/icon-512.png" background="#0f172a" />

        <preference name="AndroidXEnabled" value="true" />
    </platform>

    <plugin name="cordova-plugin-splashscreen" spec="^6.0.2" />
</widget>
